{
  "name": "dom-observer",
  "version": "0.1.0",
  "description": "Observe DOM changes",
  "type": "module",
  "main": "./dist/dom-observer.umd.cjs",
  "module": "./dist/dom-observer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dom-observer.js",
      "require": "./dist/dom-observer.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swantrace/dom-observer.git"
  },
  "keywords": [
    "promise",
    "MutationObserver",
    "DOM",
    "TypeScript"
  ],
  "author": "Fred Hong <frederickhong.5@gmail.com> (http://fredhong.ca/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/swantrace/dom-observer/issues"
  },
  "homepage": "https://github.com/swantrace/dom-observer#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
